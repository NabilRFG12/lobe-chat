# Dokploy environment for docker-compose/dokploy/docker-compose.yml.
# Put these values in Dokploy's Environment tab, or create a private .env file
# next to this compose file. Do not commit real secret values.

APP_URL=https://nabiler.com
AUTH_TRUSTED_ORIGINS=https://nabiler.com
INTERNAL_APP_URL=http://localhost:3210

LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=change-me

KEY_VAULTS_SECRET=change-me
AUTH_SECRET=change-me
JWKS_KEY=change-me

S3_ENDPOINT=https://s3.nabiler.com
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_LOBE_BUCKET=lobe

# Optional private-instance controls:
# AUTH_ALLOWED_EMAILS=you@nabiler.com
# AUTH_DISABLE_EMAIL_PASSWORD=1

# Optional analytics/build flags:
# FEATURE_FLAGS=
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ANALYTICS_POSTHOG=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_ANALYTICS_UMAMI=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
